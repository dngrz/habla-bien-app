# =====================================================================
# Variables de entorno para podman-compose (backend) y Expo (mobile).
# Copiar a .env y ajustar:
#   cp .env.example .env
# =====================================================================

# --- OpenAI (solo backend; nunca en la app móvil) ---
OPENAI_API_KEY=sk-reemplaza-por-tu-api-key
# whisper-1 es el único modelo que entrega timestamps por palabra.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o

# --- Servidor ---
# Puerto del backend publicado en el host.
BACKEND_PORT=3000
# Orígenes permitidos por CORS. Incluye el origen de la app web publicada
# (dominio distinto al del backend) y Expo web en desarrollo.
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:8081,http://127.0.0.1:8081
# Análisis permitidos por IP y por hora.
RATE_LIMIT_MAX=10

# --- App web (Expo export servido por nginx) ---
# Puerto del contenedor web publicado en el host.
WEB_PORT=8080
# URL pública ABSOLUTA del backend (dominio aparte). Se inyecta en tiempo de build.
EXPO_PUBLIC_API_URL=https://api.tu-dominio.com

# La app móvil (nativa) lee su propio mobile/.env (Expo no carga el .env de la raíz).
# Ver mobile/.env.example.
