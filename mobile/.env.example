# URL del backend. Copia este archivo a .env dentro de mobile/.
# Expo carga .env desde la carpeta del proyecto móvil, no desde la raíz.
# Para la vista web (npx expo start --web) basta localhost.
# En un dispositivo físico usa la IP LAN de tu PC, por ejemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
